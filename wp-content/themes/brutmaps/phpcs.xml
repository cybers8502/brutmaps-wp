<?xml version="1.0"?>
<ruleset name="Brutmaps">
    <description>Coding standards for the Brutmaps theme.</description>

    <file>functions.php</file>
    <file>inc</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/publish/*</exclude-pattern>
    <!-- Third-party class stubs for PHPStan only; method names mirror the real
         plugin's API and are not this project's code style to enforce. -->
    <exclude-pattern>*/phpstan-stubs/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value=".phpcs.cache"/>
    <arg value="sp"/>
    <arg name="colors"/>

    <config name="testVersion" value="8.1-"/>
    <config name="minimum_wp_version" value="6.4"/>

    <!-- Base style: PSR-12. Line length is advisory only here, not enforced. -->
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <!-- Security- and DB-focused WordPress sniffs. NonceVerification is dropped:
         REST routes gate on permission_callback and the admin filters run in
         pre_get_posts, so it only produces false positives here. -->
    <rule ref="WordPress.Security">
        <exclude name="WordPress.Security.NonceVerification"/>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="brut"/>
            </property>
        </properties>
    </rule>

    <!-- PHP cross-version compatibility -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- Tests may echo and skip escaping/nonce checks -->
    <rule ref="WordPress.Security">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
